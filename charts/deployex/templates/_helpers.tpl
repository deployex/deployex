{{/*
Chart name, truncated and DNS-1123-safe, with .Values.fullnameOverride and
nameOverride respected the way the chart template generated by `helm create` does.
*/}}
{{- define "deployex.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "deployex.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "deployex.labels" -}}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{ include "deployex.selectorLabels" . }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end -}}

{{- define "deployex.selectorLabels" -}}
app.kubernetes.io/name: {{ include "deployex.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{- define "deployex.serviceAccountName" -}}
{{- if .Values.serviceAccount.create -}}
{{- default (include "deployex.fullname" .) .Values.serviceAccount.name -}}
{{- else -}}
{{- default "default" .Values.serviceAccount.name -}}
{{- end -}}
{{- end -}}

{{/*
The DNS name every DeployEx pod resolves to reach every other one, for
peers_dns_query - the headless Service this chart creates, in this release's
namespace. Matches the form the YAML guide's own example uses:
"deployex.default.svc.cluster.local".
*/}}
{{- define "deployex.peersDnsQuery" -}}
{{- printf "%s-headless.%s.svc.cluster.local" (include "deployex.fullname" .) .Release.Namespace -}}
{{- end -}}

{{/*
deployexConfig with the keys the chart itself computes filled in where the user
left them unset. merge keeps a key .Values.deployexConfig already set and only
fills in what's missing, so an explicit override here always wins.
*/}}
{{- define "deployex.config" -}}
{{- $defaults := dict "peers_dns_query" (include "deployex.peersDnsQuery" .) -}}
{{- $agentApiDefaults := dict "port" (.Values.service.agentApi.port | int) -}}
{{- $config := deepCopy .Values.deployexConfig -}}
{{- $_ := set $config "agent_api" (merge (get $config "agent_api" | default dict) $agentApiDefaults) -}}
{{- merge $config $defaults | toYaml -}}
{{- end -}}

{{/*
The secret this pod reads DEPLOYEX_* from, whichever of secret.create /
secret.existingSecret is set - exactly one is expected, checked in secret.yaml.
*/}}
{{- define "deployex.secretName" -}}
{{- if .Values.secret.existingSecret -}}
{{- .Values.secret.existingSecret -}}
{{- else -}}
{{- include "deployex.fullname" . -}}
{{- end -}}
{{- end -}}
